# ── Database ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sulap

# ── JWT ──
SECRET_KEY=change-me-in-production-use-random-64-char-hex-string

# ── Google OAuth (GIS flow — client_id only, no secret needed) ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Frontend URL (for CORS + cookie domain) ──
FRONTEND_URL=https://sulap-xxxx-as.a.run.app

# ── Optional ──
# LOG_LEVEL=INFO
# MAX_FILE_SIZE_MB=30
